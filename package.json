{
  "name": "catlocal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "本地统一接入网关：robin（Summeretto）+ studio（aistudio-api）+ catiecli 用户脚本本地化，支持并发调度与统一管理",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node tests/run-tests.mjs",
    "verify:script": "node scripts/verify-real-script.mjs",
    "config:init": "node scripts/gen-config.mjs",
    "install-engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1"
  }
}